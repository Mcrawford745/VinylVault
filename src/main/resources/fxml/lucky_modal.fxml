<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="14" fx:controller="com.vinylvault.controller.LuckyModalController"
      xmlns:fx="http://javafx.com/fxml"
      prefWidth="460" prefHeight="340">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <fx:define>
        <ToggleGroup fx:id="modeGroup"/>
    </fx:define>

    <Label text="I'm Feeling Lucky" styleClass="app-title"/>
    <Label text="Pick your listening mode:" styleClass="section-title"/>

    <HBox spacing="12">
        <RadioButton fx:id="radioRandom"    text="Random"              toggleGroup="$modeGroup" selected="true"/>
        <RadioButton fx:id="radioFormat"    text="By Format"           toggleGroup="$modeGroup"/>
        <RadioButton fx:id="radioMood"      text="By Mood"             toggleGroup="$modeGroup"/>
        <RadioButton fx:id="radioForgotten" text="Forgotten Favorites"  toggleGroup="$modeGroup"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Format:"/>
        <ComboBox fx:id="comboFormat" prefWidth="140"/>
        <Label text="Mood:"/>
        <ComboBox fx:id="comboMood"   prefWidth="130"/>
    </HBox>

    <Button text="Spin the Wheel!" onAction="#onSpin" styleClass="btn-primary" maxWidth="Infinity"/>

    <Separator/>

    <VBox spacing="4" styleClass="lucky-result-box">
        <Label fx:id="labelResult"  text="—" styleClass="lucky-title"/>
        <Label fx:id="labelArtist"  text="" styleClass="lucky-artist"/>
        <Label fx:id="labelFormat"  text="" styleClass="lucky-sub"/>
    </VBox>
</VBox>